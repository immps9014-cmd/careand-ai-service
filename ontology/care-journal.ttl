# 자동 생성 — gen_care_journal.py (원본 care_journal.json). 직접 고치지 말 것.
@prefix care: <http://caren.aiclaude.kr/ontology#> .
@prefix cj:   <http://caren.aiclaude.kr/ontology/journal#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

cj:Chip a owl:Class ; rdfs:label "케어일지 칩"@ko ; rdfs:comment "돌봄전문가가 눌러 기록하는 관찰·수행 단위(기능 40)."@ko .
cj:Phrase a owl:Class ; rdfs:label "표현조각"@ko ; rdfs:comment "칩 하나에 대응하는 보호자용 문장 조각. LLM 은 이것만 이어 붙여 일지를 만든다."@ko .
cj:ChipCategory a owl:Class ; rdfs:label "칩 분류"@ko .
cj:code a owl:DatatypeProperty ; rdfs:label "칩 코드(저장값)"@ko ; rdfs:domain cj:Chip .
cj:inCategory a owl:ObjectProperty ; rdfs:domain cj:Chip ; rdfs:range cj:ChipCategory .
cj:hasPhrase a owl:ObjectProperty ; rdfs:domain cj:Chip ; rdfs:range cj:Phrase .
cj:text a owl:DatatypeProperty ; rdfs:domain cj:Phrase .
cj:tone a owl:DatatypeProperty ; rdfs:label "어조(good·neutral·caution·alert)"@ko .
cj:order a owl:DatatypeProperty .
cj:raisesAlert a owl:ObjectProperty ; rdfs:label "안전 알림 유발"@ko ; rdfs:domain cj:Chip ; rdfs:range care:SafetyAlert .
cj:observes a owl:ObjectProperty ; rdfs:label "관찰 케어용어"@ko ; rdfs:domain cj:Chip ; rdfs:range care:CareTerm .

cj:Cat_Meal a cj:ChipCategory ; rdfs:label "식사·수분"@ko ; cj:order 1 .
cj:Cat_Toilet a cj:ChipCategory ; rdfs:label "배설"@ko ; cj:order 2 .
cj:Cat_Sleep a cj:ChipCategory ; rdfs:label "수면·휴식"@ko ; cj:order 3 .
cj:Cat_Medication a cj:ChipCategory ; rdfs:label "투약·측정"@ko ; cj:order 4 .
cj:Cat_Activity a cj:ChipCategory ; rdfs:label "활동·운동"@ko ; cj:order 5 .
cj:Cat_Hygiene a cj:ChipCategory ; rdfs:label "위생·청결"@ko ; cj:order 6 .
cj:Cat_Mood a cj:ChipCategory ; rdfs:label "정서·소통"@ko ; cj:order 7 .
cj:Cat_Health a cj:ChipCategory ; rdfs:label "건강 관찰"@ko ; cj:order 8 .
cj:Cat_Safety a cj:ChipCategory ; rdfs:label "안전 알림"@ko ; cj:order 9 .
cj:Cat_Living a cj:ChipCategory ; rdfs:label "생활 지원"@ko ; cj:order 10 .
cj:Cat_Newborn a cj:ChipCategory ; rdfs:label "산모·신생아"@ko ; cj:order 11 .

cj:Chip_MealAll a cj:Chip ;
    cj:code "MealAll" ;
    rdfs:label "식사 모두 드심"@ko ;
    cj:inCategory cj:Cat_Meal ;
    cj:hasPhrase cj:Phrase_MealAll ;
    cj:tone "good" ;
    cj:order 1 .
cj:Phrase_MealAll a cj:Phrase ; cj:text "식사를 남김없이 맛있게 드셨어요"@ko .
cj:Chip_MealHalf a cj:Chip ;
    cj:code "MealHalf" ;
    rdfs:label "식사 절반 정도"@ko ;
    cj:inCategory cj:Cat_Meal ;
    cj:hasPhrase cj:Phrase_MealHalf ;
    cj:tone "neutral" ;
    cj:order 2 .
cj:Phrase_MealHalf a cj:Phrase ; cj:text "식사는 절반 정도 드셨어요"@ko .
cj:Chip_MealLittle a cj:Chip ;
    cj:code "MealLittle" ;
    rdfs:label "식사 조금만"@ko ;
    cj:inCategory cj:Cat_Meal ;
    cj:hasPhrase cj:Phrase_MealLittle ;
    cj:tone "caution" ;
    cj:order 3 .
