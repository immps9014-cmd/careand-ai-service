cj:Chip_FluidGood a cj:Chip ;
    cj:code "FluidGood" ;
    rdfs:label "수분 충분"@ko ;
    cj:inCategory cj:Cat_Meal ;
    cj:hasPhrase cj:Phrase_FluidGood ;
    cj:tone "good" ;
